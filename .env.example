# ============================================================
# Iconic Design — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# Admin recovery master key (keep this safe and private)
ADMIN_MASTER_KEY=change-this-to-a-secure-master-key

# PostgreSQL Database URL (Supabase)
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string (URI mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Email (for contact form notifications)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Server port (optional, defaults to 5001 in dev)
# PORT=8000
